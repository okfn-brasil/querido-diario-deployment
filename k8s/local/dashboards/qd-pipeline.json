{
  "uid": "qd-pipeline",
  "title": "Querido Diário / Pipeline",
  "description": "Vazão, tempos, fila e recursos do pipeline de processamento dos diários (B3).",
  "tags": [
    "querido-diario",
    "pipeline"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Fonte de dados",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "querido-diario",
          "value": "querido-diario"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": ""
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "options": [],
        "regex": ""
      },
      {
        "name": "janela",
        "label": "Janela dos percentis",
        "type": "custom",
        "query": "5m,15m,1h,3h,6h",
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "3h",
            "value": "3h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Última execução do CronJob (Pushgateway)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Último push",
      "description": "Horário do último envio do CronJob data-processing ao Pushgateway.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(push_time_seconds{job=\"data-processing\"}) * 1000",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Diários por status",
      "description": "Valores do último push do CronJob ao Pushgateway. Cada execução substitui os valores da anterior, então estes números são da última execução, e não acumulados.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (qd_gazettes_processed_total{job=\"data-processing\"})",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Vazão da execução",
      "description": "Valores do último push do CronJob ao Pushgateway. Cada execução substitui os valores da anterior, então estes números são da última execução, e não acumulados. Diários por minuto de processamento (total de diários / soma dos tempos por diário); o CronJob processa um diário por vez.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "60 * sum(qd_gazette_processing_seconds_count{job=\"data-processing\"}) / sum(qd_gazette_processing_seconds_sum{job=\"data-processing\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: diários/min",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Tempo por diário (p50 / p95)",
      "description": "Valores do último push do CronJob ao Pushgateway. Cada execução substitui os valores da anterior, então estes números são da última execução, e não acumulados.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (qd_gazette_processing_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (qd_gazette_processing_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Coleta → indexado (p50 / p95)",
      "description": "Valores do último push do CronJob ao Pushgateway. Cada execução substitui os valores da anterior, então estes números são da última execução, e não acumulados.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (qd_scrape_to_index_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (qd_scrape_to_index_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "id": 7,
      "title": "Vazão e tempos por diário",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Vazão por modo e status",
      "description": "rate(qd_gazettes_processed_total[5m]), em diários por minuto. No modo cron o Pushgateway substitui os contadores a cada execução, então cada execução aparece como um pico de até 5 min (a primeira execução após subir o Pushgateway, ou uma com a mesma contagem da anterior, não gera pico). A série \"cron · última execução\" mostra a vazão de cada execução como um degrau.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "60 * sum by (mode, status) (rate(qd_gazettes_processed_total[5m]))",
          "legendFormat": "{{mode}} · {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "60 * sum(qd_gazette_processing_seconds_count{job=\"data-processing\"}) / sum(qd_gazette_processing_seconds_sum{job=\"data-processing\"})",
          "legendFormat": "cron · última execução",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: diários/min",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Tempo por diário (p50 / p95)",
      "description": "qd_gazette_processing_seconds. Fila e demais modos: histogram_quantile sobre rate(...[$janela]). CronJob: percentis do histograma da última execução no Pushgateway (degrau a cada push), porque o rate() não enxerga uma execução cuja contagem repete a da anterior.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(qd_gazette_processing_seconds_bucket{mode!=\"cron\"}[$janela])))",
          "legendFormat": "p50 · {{mode}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(qd_gazette_processing_seconds_bucket{mode!=\"cron\"}[$janela])))",
          "legendFormat": "p95 · {{mode}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (qd_gazette_processing_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p50 · cron (última execução)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (qd_gazette_processing_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p95 · cron (última execução)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Latência coleta → indexado (p50 / p95)",
      "description": "qd_scrape_to_index_seconds (agora − scraped_at, só diários indexados com sucesso). Fila e demais modos: histogram_quantile sobre rate(...[$janela]). CronJob: percentis do histograma da última execução no Pushgateway (degrau a cada push), porque o rate() não enxerga uma execução cuja contagem repete a da anterior.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(qd_scrape_to_index_seconds_bucket{mode!=\"cron\"}[$janela])))",
          "legendFormat": "p50 · {{mode}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(qd_scrape_to_index_seconds_bucket{mode!=\"cron\"}[$janela])))",
          "legendFormat": "p95 · {{mode}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (qd_scrape_to_index_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p50 · cron (última execução)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (qd_scrape_to_index_seconds_bucket{job=\"data-processing\"}))",
          "legendFormat": "p95 · cron (última execução)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 11,
      "title": "Fila de extração (Parte C)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Profundidade da fila e DLQ",
      "description": "Tamanho das listas no redis-queue, via redis_exporter com REDIS_EXPORTER_CHECK_SINGLE_KEYS=db0=extraction,db0=qd:extraction:dead. Fica vazio até a fila da Parte C subir (overlay dev-queue).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(redis_key_size{namespace=\"$namespace\", key=\"extraction\"})",
          "legendFormat": "fila (extraction)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(redis_key_size{namespace=\"$namespace\", key=\"qd:extraction:dead\"})",
          "legendFormat": "DLQ (qd:extraction:dead)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Réplicas do extraction-worker",
      "description": "Réplicas desejadas (KEDA/HPA) e existentes do Deployment extraction-worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=\"extraction-worker\"})",
          "legendFormat": "desejadas",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(kube_deployment_status_replicas{namespace=\"$namespace\", deployment=\"extraction-worker\"})",
          "legendFormat": "réplicas",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=\"extraction-worker\"})",
          "legendFormat": "disponíveis",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Recursos por pod",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "CPU por pod",
      "description": "rate(container_cpu_usage_seconds_total), em cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
